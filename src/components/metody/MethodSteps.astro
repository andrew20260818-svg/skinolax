---
// Метод лечения: общий порядок работы с покрытием по разделам 2–6 Рекомендаций.
import Rec from './Rec.astro';
import { NB, type Nozologiya } from '../../lib/metody';
interface Props { d: Nozologiya }
const skin = Astro.props.d.slug !== 'posleoperacionnye-pervichnoe' ? 'до 2 см' : 'до 20 мм';
const steps: [string, string, [string, number][]][] = [
  ['Оценка раневого ложа', 'Перед каждым нанесением: тканевые структуры, инфекционный статус, перфузия, экссудация, состояние кожи вокруг раны. '
    + `Критический уровень обсеменённости — 10⁵${NB}КОЕ/г ткани; признаки критической ишемии — противопоказание до восстановления кровотока.`, [['2.2.1', 7], ['2.2.1', 10]]],
  ['Подготовка ложа', 'Некрэктомия, тщательный гемостаз, антисептик по выбору врача, обильное промывание физраствором, высушивание кожи вокруг раны, удаление излишков экссудата, '
    + `барьерное средство при риске мацерации. Не рекомендуются: перекись водорода 3${NB}%, растворы йода, спиртовые растворы, сильные окислители.`, [['2.2.2', 14]]],
  ['Нанесение', `Положение пациента устойчивое, рана по возможности горизонтально. Нанесение — только в жидкой стадии, поперечно, с заходом на здоровую кожу ${skin} по периметру. `
    + 'При обширной ране — несколько упаковок вплотную друг к другу; при обильной экссудации — двухслойная методика. На стадии отверждения покрытие не прижимать и не разглаживать.',
    [['3.6', 23], ['3.3', 17]]],
  ['Фиксация', 'Обычно не требуется. Дополнительная фиксация (пластырь, бинт, трубчатый бинт, компрессионный трикотаж) — при подвижной зоне, обильной экссудации, мацерации, '
    + 'сниженном тургоре, заходе на кожу менее 5 мм, трении одеждой, спутанном сознании. Без избыточной компрессии.', [['4', 28]]],
  ['Контроль', 'Покрытие нельзя мочить (душ, ванна, баня). Замена при: аллергической реакции; намокании с изменением цвета на белый или розовый; набухании; отхождении от раны; попадании мочи или кала.',
    [['5.2', 30]]],
  ['Снятие', 'Прижать кожу рядом, приподнять край и плавно тянуть вдоль кожи «на себя». При затруднении — смочить физраствором, подождать не менее 30 секунд. '
    + 'Утилизация — медицинские отходы класса Б.', [['6', 34]]],
];
---
<ol class="msteps">{steps.map(([h, t, refs]) => <li><h3>{h}</h3><p>{t}</p>{refs.map(([s, p], i) => <>{i > 0 && ' '}<Rec sec={s} page={p} /></>)}</li>)}</ol>
